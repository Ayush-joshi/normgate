{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://normgate.dev/schemas/v1/test-case.schema.json",
  "title": "TestCase",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.(0|[1-9][0-9]*)$",
      "maxLength": 16
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "event": {
      "$ref": "event-envelope.schema.json"
    },
    "expected_decision": {
      "$ref": "decision.schema.json"
    },
    "extensions": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+/[a-z][a-z0-9_.-]*$"
      },
      "additionalProperties": true
    }
  },
  "required": [
    "schema_version",
    "id",
    "description",
    "event",
    "expected_decision"
  ]
}
