{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://normgate.dev/schemas/v1/resource.schema.json",
  "title": "Resource",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.(0|[1-9][0-9]*)$",
      "maxLength": 16
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "kind": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)*$"
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "classifications": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)*$"
      },
      "maxItems": 1024,
      "uniqueItems": true,
      "x-normgate-set": true
    },
    "data_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "maxItems": 1024,
      "uniqueItems": true,
      "x-normgate-set": true
    },
    "extensions": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+/[a-z][a-z0-9_.-]*$"
      },
      "additionalProperties": true
    }
  },
  "required": [
    "schema_version",
    "id",
    "kind",
    "tenant_id",
    "classifications"
  ]
}
