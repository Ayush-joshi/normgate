{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://normgate.dev/schemas/v1/destination.schema.json",
  "title": "Destination",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.(0|[1-9][0-9]*)$",
      "maxLength": 16
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "kind": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)*$"
    },
    "uri": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "format": "uri",
      "pattern": "^https?://[^/\\s]+"
    },
    "region": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "handling": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "retention_allowed": {
          "type": "boolean"
        },
        "training_allowed": {
          "type": "boolean"
        }
      },
      "required": []
    },
    "extensions": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+/[a-z][a-z0-9_.-]*$"
      },
      "additionalProperties": true
    }
  },
  "required": [
    "schema_version",
    "id",
    "kind",
    "uri"
  ]
}
