{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://normgate.dev/schemas/v1/operation.schema.json",
  "title": "Operation",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.(0|[1-9][0-9]*)$",
      "maxLength": 16
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "kind": {
      "type": "string",
      "enum": [
        "model.invoke",
        "retrieval.query",
        "tool.call",
        "response.emit",
        "memory.read",
        "memory.write",
        "memory.update",
        "memory.delete"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "arguments_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "data_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "maxItems": 1024,
      "uniqueItems": true,
      "x-normgate-set": true
    },
    "resources": {
      "type": "array",
      "items": {
        "$ref": "resource.schema.json"
      },
      "maxItems": 1024
    },
    "destination": {
      "$ref": "destination.schema.json"
    },
    "classifications": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)*$"
      },
      "maxItems": 1024,
      "uniqueItems": true,
      "x-normgate-set": true
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)*$"
    },
    "extensions": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+/[a-z][a-z0-9_.-]*$"
      },
      "additionalProperties": true
    }
  },
  "required": [
    "schema_version",
    "id",
    "kind",
    "name",
    "arguments_digest",
    "data_refs",
    "resources",
    "destination",
    "classifications",
    "purpose"
  ]
}
